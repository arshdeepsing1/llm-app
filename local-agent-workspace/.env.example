# Copy to .env. Keep credentials outside Git.
# Use a file containing DBRICKS_URL=... and DBRICKS_TOKEN=...
LOCAL_AGENT_ENV_FILE=/absolute/path/to/env_vars.txt
LOCAL_AGENT_WORKSPACE=/absolute/path/to/project
LOCAL_AGENT_RUNTIME=databricks
LOCAL_AGENT_MODEL=databricks-gpt-oss-120b
# For a Claude-enabled workspace:
# LOCAL_AGENT_RUNTIME=claude
# LOCAL_AGENT_MODEL=system.ai.your-claude-model
# CLAUDE_CLI_PATH=/absolute/path/to/compatible/claude
# CLAUDE_MCP_CONFIG=/absolute/path/to/mcp.json
# LOCAL_AGENT_CLAUDE_SKILLS=1
# LOCAL_AGENT_ANTHROPIC_PATH=/ai-gateway/anthropic
# Default port is 8765.
